{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: 3dsudoku",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/prototype/3dsudoku.py",
            "console": "integratedTerminal",
        },
        {
            "name": "Python Debugger: Current File w params",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": ["out.txt", "out-cpp.txt"]
        }        ,
        {
            "name": "C++: Build and Debug 3dsudoku.cpp",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/3dsudoku",
            "args": ["8"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "build 3dsudoku",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for lldb",
                    "text": "settings set target.pretty-printing true",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}