{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: 3dsudoku",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/prototype/3dsudoku.py",
            "console": "integratedTerminal",
        },
        {
            "name": "Python Debugger: Current File w params",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": ["out.txt", "out-cpp.txt"]
        }
    ]
}